{
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "arrowParens": "always",
  "tabWidth": 2,
  "useTabs": false,
  "jsxSingleQuote": false,
  "semi": true,
  "printWidth": 120,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "quoteProps": "as-needed",
  "experimentalTernaries": true,
  "overrides": [
    {
      "files": ["*.mts", "*.cts", "*.ts", "*.tsx"],
      "options": {
        "parser": "typescript"
      }
    }
  ]
}
